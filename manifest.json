{
  "manifest_version": 3,
  "name": "电商图片提取下载器",
  "version": "1.0.0",
  "description": "在淘宝 / 天猫 / 京东 / 拼多多商家版的商品详情页一键提取全部图片，勾选后批量下载为 PNG。",
  "minimum_chrome_version": "111",

  "permissions": [
    "downloads",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],

  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.jd.com/*",
    "*://*.jd.hk/*",
    "*://*.mms.pinduoduo.com/*",
    "*://*.alicdn.com/*",
    "*://*.tbcdn.cn/*",
    "*://*.360buyimg.com/*",
    "*://*.jdimg.com/*",
    "*://*.pddpic.com/*",
    "*://*.yangkeduo.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "action": {
    "default_title": "获取页面图片",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.jd.hk/*",
        "*://*.mms.pinduoduo.com/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/shared/dom.js",
        "src/adapters/generic.js",
        "src/adapters/taobao.js",
        "src/adapters/jd.js",
        "src/adapters/pinduoduo.js",
        "src/content/collector.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
